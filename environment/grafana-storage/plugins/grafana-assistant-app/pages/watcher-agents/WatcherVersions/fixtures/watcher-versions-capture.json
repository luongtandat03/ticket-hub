      "definition": {
        "schemaVersion": 1,
        "name": "Checkout API health",
        "description": "Monitors checkout availability before calibration.",
        "prompt": "Watch checkout availability and customer-impacting regressions.",
        "triggerIntervalSeconds": 900,
        "sensitivity": "balanced",
        "datasourceUids": ["prom", "loki"],
        "queries": [
          {
            "id": "latency",
            "type": "promql",
            "datasourceUid": "prom",
            "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
            "comment": "Checkout API p95 latency",
            "enabled": true,
            "role": "current_health",
            "thresholds": {
              "comparator": "gt",
              "warning": 0.4,
              "critical": 0.8,
              "source": "checkout-latency-slo"
            },
            "goodWhen": "low"
          },
          {
            "id": "checkout-logs",
            "type": "logql",
            "datasourceUid": "loki",
            "expr": "{service=\"checkout\"} | logfmt",
            "comment": "Unexpected checkout errors",
            "enabled": true,
            "role": "fast_incident",
            "goodWhen": "absent"
          }
        ],
        "calibrationContext": "Normal p95 latency is below 400 ms. Deployments may briefly raise it to 700 ms.",
        "staticLogPolicies": {
          "checkout-logs": {
            "patterns": [
              {
                "key": "payment retry",
                "pattern": "payment retry scheduled",
                "level": "warn",
                "classification": "acknowledged",
                "classifiedBy": "calibration"
              }
            ],
            "benignLineFilters": ["health check completed"]
          }
        }
      }
    },
